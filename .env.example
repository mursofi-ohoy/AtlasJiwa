# ATLAS JIWA — Node/Express (server/) environment variables
# Salin ke .env lalu isi nilainya:  cp .env.example .env

PORT=3000
NODE_ENV=development

# Connection string CockroachDB/PostgreSQL, lihat sql/schema.sql
DATABASE_URL=

# WAJIB string acak panjang (>=16 karakter). HARUS SAMA PERSIS dengan
# JWT_SECRET di backend/.env -- FastAPI memverifikasi token yang
# ditandatangani Node dengan secret ini (lihat backend/app/auth.py).
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Same-origin secara default (frontend disajikan dari server yang
# sama). Isi eksplisit hanya jika frontend & backend Node berjalan
# di origin berbeda.
CORS_ORIGIN=

# Alamat internal FastAPI (backend/app/, lihat server/routes/agent.routes.js).
# Default sudah benar untuk development di satu mesin yang sama;
# FastAPI TIDAK PERLU dan TIDAK BOLEH diekspos langsung ke publik.
FASTAPI_BASE_URL=http://127.0.0.1:8000
