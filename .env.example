# ATLAS JIWA — Node/Express (server/) environment variables
# Salin ke .env lalu isi nilainya:  cp .env.example .env

PORT=3000
NODE_ENV=development

# Connection string CockroachDB/PostgreSQL, lihat sql/schema.sql
DATABASE_URL=

# WAJIB string acak panjang (>=16 karakter), dipakai untuk menandatangani
# cookie sesi JWT.
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Same-origin secara default (frontend disajikan dari server yang
# sama). Isi eksplisit hanya jika frontend & backend Node berjalan
# di origin berbeda.
CORS_ORIGIN=
