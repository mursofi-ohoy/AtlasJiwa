# ATLAS JIWA — FastAPI (backend/) environment variables
# Salin ke backend/.env lalu isi nilainya: cp .env.example .env

# Connection string yang SAMA dengan DATABASE_URL Node (satu database
# yang sama dipakai kedua layer), lihat sql/schema.sql.
DATABASE_URL=

# WAJIB SAMA PERSIS dengan JWT_SECRET di .env Node (root project) --
# FastAPI hanya memverifikasi token yang diterbitkan Node saat login,
# tidak punya sistem auth sendiri. Lihat app/auth.py.
JWT_SECRET=

# URL endpoint generate Ollama. Default sudah benar untuk Ollama lokal.
QWEN_API_URL=http://127.0.0.1:11434/api/generate

# Nama model Ollama yang dipanggil (harus sudah di-pull: `ollama pull qwen3:4b`).
OLLAMA_MODEL=qwen3:4b

# Timeout (detik) menunggu balasan Ollama.
OLLAMA_TIMEOUT_SECONDS=120
